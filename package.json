{
  "name": "grid-journal-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --go",
    "tunnel": "expo start --go --tunnel ngrok --port 8083",
    "tunnel:expo": "expo start --go --tunnel expo",
    "android": "expo start --go --android",
    "web": "expo start --web",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit",
    "export:android": "expo export --platform android",
    "export:web": "expo export --platform web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/react": "~19.3.0",
    "expo": "~58.0.23",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-sharing": "~58.0.22",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3"
  }
}
